# Copy this file to .env.local. Never commit real keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
NOVA_ORCHESTRATOR_KEY=replace-with-a-random-key-of-at-least-24-characters
HOCKER_ONE_API_URL=http://host.docker.internal:3000

# Local model used when cloud credits or Railway are unavailable.
OLLAMA_LOCAL_MODEL=qwen2.5:7b

# Cloud providers remain optional fallbacks.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
BASE44_API_KEY=

# Set realistic monthly ceilings. NOVA skips a provider after its ceiling.
BUDGETS_ENABLED=true
BUDGET_OPENAI=100
BUDGET_GEMINI=100
BUDGET_ANTHROPIC=100

MCP_ENABLED=true
NOVA_MIRROR_NODE_ENABLED=true
NOVA_MIRROR_NODE_ID=nova-local-mirror-1
