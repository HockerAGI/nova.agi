SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NOVA_ORCHESTRATOR_KEY=

HOCKER_COMMAND_HMAC_SECRET=
# opcionales de compat:
# COMMAND_HMAC_SECRET=
# NOVA_COMMAND_HMAC_SECRET=

DEFAULT_COMMAND_NODE_ID=hocker-node-1
DEFAULT_PROJECT_ID=hocker-one

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
NODE_ENV=production
HOCKER_ONE_API_URL=http://localhost:3000
BUDGETS_ENABLED=true
BUDGET_OPENAI=100
BUDGET_GEMINI=100
BUDGET_ANTHROPIC=100

# === HOCKER ACTION ROUTING ===
CLOUD_COMMAND_NODE_ID=cloud-hocker-one
DEFAULT_COMMAND_NODE_ID=hocker-node-1

# === NOVA NATIVE PROVIDER ROUTER ===
# NOVA mantiene identidad única; los proveedores son motores internos.
DEFAULT_PROVIDER=openai
PROVIDER_FALLBACKS=openai,gemini,anthropic,ollama
TEXT_PROVIDER_ORDER=openai,gemini,anthropic,ollama
CODE_PROVIDER_ORDER=openai,anthropic,gemini,ollama
LONG_CONTEXT_PROVIDER_ORDER=gemini,openai,anthropic,ollama
IMAGE_PROVIDER=openai
VIDEO_PROVIDER=gemini
HIDE_PROVIDER_FROM_USER=true

# NOVA Always-On Cognitive Mesh — 12.7M-1
# Provider/model switching is internal and must never be exposed to users.
HIDE_PROVIDER_FROM_USER=true
NOVA_SURVIVAL_MODE_ENABLED=true
NOVA_SURVIVAL_REPLY=

# Optional model overrides. Leave blank to use code defaults.
OPENAI_MODEL_AUTO=
OPENAI_MODEL_FAST=
OPENAI_MODEL_PRO=
GEMINI_MODEL_AUTO=
GEMINI_MODEL_FAST=
GEMINI_MODEL_PRO=
ANTHROPIC_MODEL_AUTO=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_PRO=
OLLAMA_MODEL_AUTO=
OLLAMA_MODEL_FAST=
OLLAMA_MODEL_PRO=
