SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NODE_ENV=production
# Production containers normally bind all interfaces behind a reverse proxy.
# Development defaults to 127.0.0.1 when NOVA_HOST is omitted.
NOVA_HOST=0.0.0.0
NOVA_ORCHESTRATOR_KEY=

HOCKER_COMMAND_HMAC_SECRET=
# Optional compatibility aliases:
# COMMAND_HMAC_SECRET=
# NOVA_COMMAND_HMAC_SECRET=

# Break-glass compatibility only. Keep false in Railway production so every
# mutation travels as an MCP draft to Hocker ONE Owner Gate.
NOVA_LEGACY_COMMAND_QUEUE_ENABLED=false

DEFAULT_COMMAND_NODE_ID=hocker-node-1
DEFAULT_PROJECT_ID=hocker-one
CLOUD_COMMAND_NODE_ID=cloud-hocker-one

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
HOCKER_ONE_API_URL=https://hockerone.vercel.app
BUDGETS_ENABLED=true
BUDGET_OPENAI=100
BUDGET_GEMINI=100
BUDGET_ANTHROPIC=100

# === NOVA NATIVE PROVIDER ROUTER ===
# NOVA keeps one public identity; providers remain internal engines.
DEFAULT_PROVIDER=openai
PROVIDER_FALLBACKS=openai,gemini,anthropic,ollama
TEXT_PROVIDER_ORDER=openai,gemini,anthropic,ollama
CODE_PROVIDER_ORDER=openai,anthropic,gemini,ollama
LONG_CONTEXT_PROVIDER_ORDER=gemini,openai,anthropic,ollama
IMAGE_PROVIDER=openai
VIDEO_PROVIDER=gemini
HIDE_PROVIDER_FROM_USER=true

NOVA_SURVIVAL_MODE_ENABLED=true
NOVA_SURVIVAL_REPLY=

# Optional model overrides. Leave blank to use code defaults.
OPENAI_MODEL_AUTO=
OPENAI_MODEL_FAST=
OPENAI_MODEL_PRO=
GEMINI_MODEL_AUTO=
GEMINI_MODEL_FAST=
GEMINI_MODEL_PRO=
ANTHROPIC_MODEL_AUTO=
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_PRO=
OLLAMA_MODEL_AUTO=
OLLAMA_MODEL_FAST=
OLLAMA_MODEL_PRO=

# Debug only. Keep empty in production.
NOVA_EXPOSE_INTERNAL_META=

# === MCP CONNECTORS ===
MCP_ENABLED=true

# GitHub reads are limited to these repositories. Mutations are always deferred
# to the Hocker ONE Owner Gate and never execute inside nova.agi.
GITHUB_TOKEN=
# HOCKER_GITHUB_TOKEN=
# GH_TOKEN=
NOVA_GITHUB_ALLOWED_REPOS=HockerAGI/hocker.one,HockerAGI/nova.agi,HockerAGI/hocker-node-agent

# Supabase service-role reads are restricted to an operational table allowlist.
# Override only after reviewing the requested table for secrets and tenant scope.
# NOVA_SUPABASE_READ_TABLES=agi_tasks,agi_runs,nodes,node_heartbeats,projects,events

VERCEL_TOKEN=
VERCEL_TEAM_ID=
# HOCKER_VERCEL_TOKEN=
# HOCKER_VERCEL_TEAM_ID=

# Reuses OPENAI_API_KEY unless set separately.
# HOCKER_OPENAI_API_KEY=
OPENAI_ORG_ID=

# === MIRROR NODE ===
NOVA_MIRROR_NODE_ENABLED=true
NOVA_MIRROR_NODE_ID=nova-mirror-1
